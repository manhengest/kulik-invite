# Copy to .env.deploy (gitignored) and fill in.
#   cp .env.deploy.example .env.deploy

DEPLOY_HOST=ksus.ftp.tools
DEPLOY_USER=ksus
DEPLOY_PORT=22
DEPLOY_PASS=

# Document root for https://event.kuliksystem.us/
# Create the subdomain in the hosting panel if the folder does not exist yet.
DEPLOY_PATH=/home/ksus/kuliksystem.us/event
DEPLOY_URL=https://event.kuliksystem.us
